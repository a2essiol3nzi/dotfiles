// dwlbar-like layout: tags on the left, system status on the right.
{
  "layer": "top",
  "position": "top",
  "height": 20,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
  ],
  "clock": {
    "format": "{:%H:%M, %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "shift_up",
      "on-click": "shift_down"
    }
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": " {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphones": "",
      "default": [
        "",
        ""
      ]
    },
    "scroll-step": 5
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%"
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%"
  },
  "battery": {
    "interval": 15,
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-charging": "󰂄 {capacity}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
